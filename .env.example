GARMIN_EMAIL=your_garmin_email
GARMIN_PASSWORD=your_garmin_password
# token 儲存資料夾；Windows 建議使用此路徑
GARMINTOKENS=%USERPROFILE%\\.garminconnect
# 可選：把壓縮成單行的 garmin_tokens.json 內容貼在這裡
GARMIN_TOKEN_JSON=
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 寫入既有 database 時，填入以下四個 ID；這是建議方式
NOTION_RAW_ACTIVITIES_DB_ID=
NOTION_RAW_LAPS_DB_ID=
NOTION_RAW_DETAIL_DB_ID=
NOTION_ANALYSIS_DB_ID=
NOTION_WEEKLY_DB_ID=
# 只有讓程式自動建立 database 時才需要；使用上面四個 ID 時可留白
NOTION_PARENT_PAGE_ID=
# 應用程式日期使用 IANA 時區；GitHub Actions 與本機建議都填 Asia/Taipei
APP_TIMEZONE=Asia/Taipei
# 每日同步模式：抓今天往前 2 天到今天，避免 Garmin 同步延遲漏抓
START_DATE=auto
END_DATE=auto
SYNC_DAYS_BACK=2
NOTION_VERSION=2022-06-28
STORE_DETAIL_JSON_BLOCKS=true
MAX_HR=
REST_HR=
WEIGHT_KG=
GARMIN_JITTER_MIN_SECONDS=30
GARMIN_JITTER_MAX_SECONDS=45
